---
// src/components/pixel/LabCard.astro
// Pixel theme lab card. CRT image strip, pixel font, external link indicator.

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"lab">;
}

const { entry } = Astro.props;
const { data, slug } = entry;

const href = data.link ?? `/lab/${slug}`;
const isExternal = !!data.link;
---

<a
  href={href}
  class="px-lab"
  aria-label={`${data.title} — ${data.summary}`}
  {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <div class="px-lab__img-wrap" aria-hidden="true">
    {data.cover_image ? (
      <img
        src={data.cover_image}
        alt=""
        class="px-lab__img"
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="px-lab__no-signal">
        <span class="px-lab__no-signal-text">// NO SIGNAL //</span>
      </div>
    )}
  </div>

  <div class="px-lab__row">
    <span class="px-lab__cursor" aria-hidden="true">▶</span>

    <div class="px-lab__body">
      <p class="px-lab__title">{data.title}</p>
      <p class="px-lab__meta">{data.type?.toUpperCase()}</p>
    </div>

    <span class="px-lab__link-flag" aria-hidden="true">
      {isExternal ? "[→]" : "[/]"}
    </span>
  </div>
</a>

<style>
  .px-lab {
    display: block;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--text-2);
    overflow: hidden;
  }

  .px-lab:last-child { border-bottom: none; }

  .px-lab:hover { background: rgba(0, 255, 65, 0.05); }

  /* CRT image strip */

  .px-lab__img-wrap {
    position: relative;
    width: 100%;
    height: 56px;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
  }

  .px-lab__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter:
      grayscale(1)
      contrast(1.8)
      brightness(0.55)
      sepia(1)
      hue-rotate(85deg)
      saturate(1.8);
    image-rendering: pixelated;
  }

  .px-lab:hover .px-lab__img {
    filter:
      grayscale(1)
      contrast(1.8)
      brightness(0.75)
      sepia(1)
      hue-rotate(85deg)
      saturate(2);
  }

  .px-lab__img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent 0px,
      transparent 2px,
      rgba(0, 0, 0, 0.25) 2px,
      rgba(0, 0, 0, 0.25) 3px
    );
    pointer-events: none;
    z-index: 1;
  }

  .px-lab__img-wrap::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 255, 65, 0.10) 0%,
      transparent              30%,
      transparent              70%,
      rgba(0, 255, 65, 0.08) 100%
    );
    pointer-events: none;
    z-index: 2;
    mix-blend-mode: screen;
  }

  /* No-signal placeholder */

  .px-lab__no-signal {
    width: 100%;
    height: 100%;
    background-color: #090e09;
    background-image:
      radial-gradient(circle, rgba(0, 255, 65, 0.18) 1px, transparent 1px),
      radial-gradient(circle, rgba(0, 255, 65, 0.08) 1px, transparent 1px);
    background-size: 8px 8px, 4px 4px;
    background-position: 0 0, 2px 2px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .px-lab__no-signal-text {
    font-family: var(--font-display);
    font-size: 0.5rem;
    letter-spacing: 0.18em;
    color: rgba(0, 255, 65, 0.35);
    animation: pixel-blink 2.4s steps(1) infinite;
  }

  /* Text row */

  .px-lab__row {
    display: grid;
    grid-template-columns: 12px 1fr auto;
    align-items: center;
    gap: 0 0.75rem;
    padding: 0.6rem 1rem;
  }

  .px-lab__cursor {
    font-family: var(--font-display);
    font-size: 8px;
    color: var(--accent);
    opacity: 0;
    justify-self: center;
  }

  .px-lab:hover .px-lab__cursor { opacity: 1; }

  .px-lab__body {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .px-lab__title {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.04em;
    line-height: 1.6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--text-1);
  }

  .px-lab:hover .px-lab__title { color: var(--accent); }

  .px-lab__meta {
    font-family: var(--font-display);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    color: var(--text-4);
  }

  .px-lab__link-flag {
    font-family: var(--font-display);
    font-size: 0.5rem;
    letter-spacing: 0.1em;
    color: var(--text-3);
    flex-shrink: 0;
  }

  .px-lab:hover .px-lab__link-flag { color: var(--accent); }
</style>
