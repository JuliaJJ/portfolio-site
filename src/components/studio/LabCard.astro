---
// src/components/studio/LabCard.astro
// Studio theme: compact numbered row for lab entries.
// Matches WorkCard interaction pattern — left rule reveal, title translate.

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"lab">;
  index: number;
}

const { entry, index } = Astro.props;
const { data, slug } = entry;

const href = data.link ?? `/lab/${slug}`;
const isExternal = !!data.link;
const num = String(index).padStart(2, "0");
---

<a
  href={href}
  class="st-lc"
  aria-label={`${data.title} — ${data.summary}`}
  {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <span class="st-lc__num" aria-hidden="true">{num}</span>
  <span class="st-lc__type">{data.type}</span>
  <span class="st-lc__title">{data.title}</span>
  {isExternal && (
    <span class="st-lc__ext" aria-hidden="true">↗</span>
  )}
</a>

<style>
  .st-lc {
    position: relative;
    display: grid;
    grid-template-columns: 44px 80px 1fr auto;
    align-items: center;
    gap: 0 var(--space-6);
    padding: var(--space-6) 0 var(--space-6) var(--space-5);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
  }

  .st-lc::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--duration-base) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .st-lc:hover::before      { transform: scaleY(1); }
    .st-lc:hover .st-lc__title { transform: translateX(6px); }

    .st-lc {
      animation: st-row-in var(--duration-slow) var(--ease-out) var(--st-delay, 0ms) both;
    }
    @keyframes st-row-in {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  }

  .st-lc__num {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    color: var(--text-4);
    flex-shrink: 0;
  }

  .st-lc__type {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-3);
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: 2px 8px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .st-lc__title {
    font-size: var(--text-lg);
    font-weight: var(--weight-light);
    color: var(--text-1);
    letter-spacing: var(--tracking-tight);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .st-lc__ext {
    font-size: var(--text-sm);
    color: var(--accent);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .st-lc {
      grid-template-columns: 40px 1fr auto;
      grid-template-rows: auto auto;
      row-gap: var(--space-1);
      padding: var(--space-5) 0 var(--space-5) var(--space-4);
    }
    .st-lc__type { grid-column: 1; grid-row: 2; font-size: 0.6rem; }
    .st-lc__title { font-size: var(--text-md); }
  }
</style>
