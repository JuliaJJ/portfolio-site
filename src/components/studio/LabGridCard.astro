---
// src/components/studio/LabGridCard.astro
// Studio theme: compact two-column grid card for the lab index.
// Mirrors WorkGridCard — image dominant, info below with left-rule hover.

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"lab">;
  index: number;
}

const { entry, index } = Astro.props;
const { data, slug } = entry;

const href = data.link ?? `/lab/${slug}`;
const isExternal = !!data.link;
const num = String(index).padStart(2, "0");
---

<a
  href={href}
  class="st-lgc"
  aria-label={`${data.title} — ${data.summary}`}
  {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <div class="st-lgc__img-wrap" aria-hidden="true">
    {data.cover_image ? (
      <img
        src={data.cover_image}
        alt={data.cover_alt ?? data.title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="img-placeholder">
        <span class="img-placeholder__label">Cover image</span>
      </div>
    )}
  </div>

  <div class="st-lgc__info">
    <span class="st-lgc__num" aria-hidden="true">{num}</span>
    <span class="st-lgc__title">
      {data.title}{isExternal && <span class="st-lgc__ext" aria-hidden="true"> ↗</span>}
    </span>
    <div class="st-lgc__meta">
      <span class="st-lgc__type">{data.type}</span>
      <span class="st-lgc__year">{data.year}</span>
    </div>
  </div>
</a>

<style>
  .st-lgc {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .st-lgc__img-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin-bottom: var(--space-4);
  }

  .st-lgc__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.5) brightness(0.9);
    transition:
      transform 500ms var(--ease-out),
      filter    400ms var(--ease-out);
  }

  .st-lgc:hover .st-lgc__img-wrap img {
    transform: scale(1.04);
    filter: saturate(1) brightness(1);
  }

  .st-lgc__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-4);
    border-left: 2px solid transparent;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .st-lgc:hover .st-lgc__info {
    border-color: var(--accent);
  }

  .st-lgc__num {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    color: var(--accent);
  }

  .st-lgc__title {
    font-size: clamp(0.95rem, 1.5vw, 1.15rem);
    font-weight: var(--weight-light);
    color: var(--text-1);
    letter-spacing: -0.02em;
    line-height: var(--leading-snug);
    transition: transform var(--duration-base) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .st-lgc:hover .st-lgc__title { transform: translateX(4px); }

    .st-lgc {
      animation: st-lgc-in var(--duration-slow) var(--ease-out) var(--st-delay, 0ms) both;
    }
    @keyframes st-lgc-in {
      from { opacity: 0; transform: translateY(12px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  }

  .st-lgc__ext {
    color: var(--accent);
  }

  .st-lgc__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-1);
  }

  .st-lgc__type {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-3);
    background: var(--bg-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    padding: 2px 6px;
  }

  .st-lgc__year {
    font-size: var(--text-xs);
    color: var(--text-4);
    letter-spacing: var(--tracking-wider);
    margin-left: auto;
  }
</style>
