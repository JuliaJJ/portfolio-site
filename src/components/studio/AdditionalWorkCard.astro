---
// src/components/studio/AdditionalWorkCard.astro
// Studio theme: compact grid card for additional work entries.
// Image-dominant; lighter metadata than case study cards.

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"additionalWork">;
}

const { entry } = Astro.props;
const { data, slug } = entry;
---

<a
  href={`/work/additional/${slug}`}
  class="st-awc"
  aria-label={`${data.title} — ${data.client}`}
>
  <div class="st-awc__img-wrap" aria-hidden="true">
    {data.cover_image ? (
      <img
        src={data.cover_image}
        alt={data.cover_alt ?? data.title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="img-placeholder">
        <span class="img-placeholder__label">Cover image</span>
      </div>
    )}
  </div>

  <div class="st-awc__info">
    <span class="st-awc__title">{data.title}</span>
    <span class="st-awc__byline">
      {data.client}
    </span>
  </div>
</a>

<style>
  .st-awc {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .st-awc__img-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    margin-bottom: var(--space-3);
  }

  .st-awc__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.5) brightness(0.9);
    transition:
      transform 500ms var(--ease-out),
      filter    400ms var(--ease-out);
  }

  .st-awc:hover .st-awc__img-wrap img {
    transform: scale(1.04);
    filter: saturate(1) brightness(1);
  }

  .st-awc__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding-left: var(--space-3);
    border-left: 2px solid transparent;
    transition: border-color var(--duration-base) var(--ease-out);
  }

  .st-awc:hover .st-awc__info {
    border-color: var(--accent);
  }

  .st-awc__title {
    font-size: var(--text-sm);
    font-weight: var(--weight-light);
    color: var(--text-1);
    letter-spacing: -0.01em;
    line-height: var(--leading-snug);
    transition: transform var(--duration-base) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .st-awc:hover .st-awc__title { transform: translateX(4px); }
  }

  .st-awc__byline {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    font-weight: var(--weight-regular);
    color: var(--text-4);
    letter-spacing: var(--tracking-wide);
  }

</style>
