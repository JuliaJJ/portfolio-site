---
// src/components/studio/WorkCard.astro
// Studio theme: full-width numbered row for work entries.
// Left rule scaleY reveals on hover; title translates right.

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
  index: number;
}

const { entry, index } = Astro.props;
const { data, slug } = entry;
const num = String(index).padStart(2, "0");
---

<a
  href={`/work/${slug}`}
  class="st-wc"
  aria-label={`${data.title} — ${data.summary}`}
>
  <span class="st-wc__num" aria-hidden="true">{num}</span>
  <span class="st-wc__title">{data.title}</span>
  <div class="st-wc__meta">
    <span class={`tag tag--${data.domain}`}>{data.domain}</span>
    {data.visibility !== "full" && (
      <span class="st-wc__nda">NDA</span>
    )}
  </div>
  <span class="st-wc__year">{data.year}</span>
  <div class="st-wc__thumb" aria-hidden="true">
    {data.cover_image ? (
      <img src={data.cover_image} alt="" loading="lazy" decoding="async" />
    ) : (
      <div class="img-placeholder" />
    )}
  </div>
</a>

<style>
  .st-wc {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr auto auto 104px;
    align-items: center;
    gap: 0 var(--space-8);
    padding: var(--space-5) 0 var(--space-5) var(--space-5);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: inherit;
  }

  /* Left rule — scaleY from top on hover */
  .st-wc::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--duration-base) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .st-wc:hover::before   { transform: scaleY(1); }
    .st-wc:hover .st-wc__title { transform: translateX(8px); }
  }

  /* Stagger fade-in — delay passed via --st-delay on the parent <li> */
  @media (prefers-reduced-motion: no-preference) {
    .st-wc {
      animation: st-row-in var(--duration-slow) var(--ease-out) var(--st-delay, 0ms) both;
    }
    @keyframes st-row-in {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  }

  .st-wc__num {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    color: var(--text-4);
    flex-shrink: 0;
  }

  .st-wc__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-light);
    color: var(--text-1);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .st-wc__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .st-wc__nda {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-warning);
    background: var(--color-warning-bg);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .st-wc__year {
    font-size: var(--text-xs);
    color: var(--text-4);
    letter-spacing: var(--tracking-wider);
    flex-shrink: 0;
  }

  /* Thumbnail */
  .st-wc__thumb {
    width: 104px;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .st-wc__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.15) brightness(0.9);
    transition:
      filter   var(--duration-base) var(--ease-out),
      transform 500ms var(--ease-out);
  }

  .st-wc:hover .st-wc__thumb img {
    filter: saturate(1) brightness(1);
    transform: scale(1.06);
  }

  @media (max-width: 640px) {
    .st-wc {
      grid-template-columns: 40px 1fr;
      grid-template-rows: auto auto;
      row-gap: var(--space-1);
      padding: var(--space-6) 0 var(--space-6) var(--space-4);
    }
    .st-wc__meta  { grid-column: 2; grid-row: 2; }
    .st-wc__year  { display: none; }
    .st-wc__thumb { display: none; }
    .st-wc__title { font-size: var(--text-lg); }
  }
</style>
