---
// src/components/studio/WorkCard.astro
// Studio theme: full-bleed image card breaking out of the gutter.
// Image is the dominant element; number + title float below.

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
  index: number;
}

const { entry, index } = Astro.props;
const { data, slug } = entry;
const num = String(index).padStart(2, "0");
---

<a
  href={`/work/${slug}`}
  class="st-wc"
  aria-label={`${data.title} — ${data.summary}`}
>
  <!-- Cover image — breaks out of the parent gutter via negative margin -->
  <div class="st-wc__img-wrap" aria-hidden="true">
    {data.cover_image ? (
      <img
        src={data.cover_image}
        alt={data.cover_alt ?? data.title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="img-placeholder">
        <span class="img-placeholder__label">Cover image</span>
      </div>
    )}
  </div>

  <!-- Info row -->
  <div class="st-wc__info">
    <span class="st-wc__num" aria-hidden="true">{num}</span>
    <span class="st-wc__title">{data.title}</span>
    <div class="st-wc__meta">
      <span class={`tag tag--${data.domain}`}>{data.domain}</span>
      {data.visibility !== "full" && (
        <span class="st-wc__nda">NDA</span>
      )}
    </div>
    <span class="st-wc__year">{data.year}</span>
  </div>
</a>

<style>
  .st-wc {
    display: block;
    text-decoration: none;
    color: inherit;
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-12);
  }

  /* ── Image — breaks out of the gutter ── */

  .st-wc__img-wrap {
    margin-inline: calc(-1 * var(--gutter));
    overflow: hidden;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-6);
  }

  .st-wc__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.55) brightness(0.95);
    transition:
      transform 700ms var(--ease-out),
      filter    500ms var(--ease-out);
  }

  .st-wc:hover .st-wc__img-wrap img {
    transform: scale(1.03);
    filter: saturate(1) brightness(1);
  }

  /* ── Info row ── */

  .st-wc__info {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: baseline;
    gap: 0 var(--space-8);
    padding-left: var(--space-5);
    position: relative;
  }

  /* Left accent rule — scaleY from top on hover */
  .st-wc__info::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform var(--duration-base) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .st-wc:hover .st-wc__info::before { transform: scaleY(1); }
    .st-wc:hover .st-wc__title        { transform: translateX(8px); }
  }

  /* Stagger fade-in — delay passed via --st-delay on the parent <li> */
  @media (prefers-reduced-motion: no-preference) {
    .st-wc {
      animation: st-row-in var(--duration-slow) var(--ease-out) var(--st-delay, 0ms) both;
    }
    @keyframes st-row-in {
      from { opacity: 0; transform: translateY(16px); }
      to   { opacity: 1; transform: translateY(0); }
    }
  }

  .st-wc__num {
    font-size: clamp(2rem, 4.5vw, 4.5rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.04em;
    line-height: 1;
    color: var(--accent);
    flex-shrink: 0;
  }

  .st-wc__title {
    font-size: clamp(1.1rem, 2.5vw, 2rem);
    font-weight: var(--weight-light);
    color: var(--text-1);
    letter-spacing: -0.02em;
    line-height: var(--leading-snug);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .st-wc__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .st-wc__nda {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-warning);
    background: var(--color-warning-bg);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .st-wc__year {
    font-size: var(--text-xs);
    color: var(--text-4);
    letter-spacing: var(--tracking-wider);
    flex-shrink: 0;
  }

  @media (max-width: 640px) {
    .st-wc__info {
      grid-template-columns: auto 1fr;
      grid-template-rows: auto auto;
      row-gap: var(--space-1);
    }
    .st-wc__meta { grid-column: 2; grid-row: 2; }
    .st-wc__year { display: none; }
    .st-wc__num  { font-size: clamp(1.5rem, 8vw, 2.5rem); }
  }
</style>
