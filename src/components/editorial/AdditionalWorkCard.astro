---
// src/components/editorial/AdditionalWorkCard.astro
// Editorial theme: compact grid card for additional work entries.
// Border-top, image, italic serif title, client byline.

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"additionalWork">;
}

const { entry } = Astro.props;
const { data, slug } = entry;
---

<a
  href={`/work/additional/${slug}`}
  class="ed-awc"
  aria-label={`${data.title} — ${data.client}`}
>
  <div class="ed-awc__byline">
    <span class="ed-awc__client">{data.client}</span>
    {data.visibility !== "full" && (
      <span class="ed-awc__flag">NDA</span>
    )}
  </div>

  <div class="ed-awc__img-wrap" aria-hidden={!data.cover_image}>
    {data.cover_image ? (
      <img
        src={data.cover_image}
        alt={data.cover_alt ?? data.title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="img-placeholder">
        <span class="img-placeholder__label">Cover image</span>
      </div>
    )}
  </div>

  <h2 class="ed-awc__title">{data.title}</h2>
</a>

<style>
  .ed-awc {
    display: block;
    padding-top: var(--space-6);
    border-top: 3px solid var(--text-1);
    text-decoration: none;
    color: inherit;
  }

  .ed-awc__byline {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }

  .ed-awc__client {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-3);
  }

  .ed-awc__flag {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-info);
  }

  .ed-awc__img-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--rule-2);
    margin-bottom: var(--space-4);
  }

  .ed-awc__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.3) brightness(0.95);
    transition:
      transform 500ms var(--ease-out),
      filter    400ms var(--ease-out);
  }

  .ed-awc:hover .ed-awc__img-wrap img {
    transform: scale(1.02);
    filter: none;
  }

  .ed-awc__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.1rem, 2vw, 1.5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-1);
    transition: color var(--duration-fast) var(--ease-out);
    margin-bottom: var(--space-6);
  }

  .ed-awc:hover .ed-awc__title {
    color: var(--accent);
  }
</style>
