---
// src/components/editorial/WorkGridCard.astro
// Editorial theme: compact two-column grid card for the work index.
// Keeps the editorial rhythm — border top, issue number, italic serif title.
// No summary; typography carries the weight at this scale.

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
  index: number;
}

const { entry, index } = Astro.props;
const { data, slug } = entry;
const issueNum = String(index).padStart(2, "0");
---

<a
  href={`/work/${slug}`}
  class="ed-gc"
  aria-label={`${data.title} — ${data.summary}`}
>

  <div class="ed-gc__header">
    <span class="ed-gc__num" aria-hidden="true">{issueNum}</span>
    <div class="ed-gc__byline">
      <span class={`ed-gc__domain`}>{data.domain}</span>
      <span class="ed-gc__year">{data.year}</span>
      {data.visibility === "partial" && (
        <span class="ed-gc__flag">Process shown</span>
      )}
      {data.visibility === "request" && (
        <span class="ed-gc__flag ed-gc__flag--nda">NDA</span>
      )}
    </div>
  </div>

  <div class="ed-gc__img-wrap" aria-hidden={!data.cover_image}>
    {data.cover_image ? (
      <img
        src={data.cover_image}
        alt={data.cover_alt ?? data.title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="img-placeholder">
        <span class="img-placeholder__label">Cover image</span>
      </div>
    )}
  </div>

  <h2 class="ed-gc__title">{data.title}</h2>

</a>

<style>
  .ed-gc {
    display: block;
    padding-top: var(--space-6);
    border-top: 3px solid var(--text-1);
    text-decoration: none;
    color: inherit;
  }

  .ed-gc__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }

  .ed-gc__num {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 0.85;
    color: var(--text-4);
    letter-spacing: -0.04em;
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .ed-gc:hover .ed-gc__num {
    color: var(--accent);
  }

  .ed-gc__byline {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .ed-gc__domain {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    padding: 2px 6px;
    border: 1px solid var(--rule-2);
    color: var(--text-3);
  }

  .ed-gc__year {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-3);
  }

  .ed-gc__flag {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--color-warning);
  }

  .ed-gc__flag--nda {
    color: var(--color-info);
  }

  .ed-gc__img-wrap {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid var(--rule-2);
    margin-bottom: var(--space-5);
  }

  .ed-gc__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: grayscale(0.3) brightness(0.95);
    transition:
      transform 500ms var(--ease-out),
      filter    400ms var(--ease-out);
  }

  .ed-gc:hover .ed-gc__img-wrap img {
    transform: scale(1.02);
    filter: none;
  }

  .ed-gc__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.25rem, 2.5vw, 1.75rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--text-1);
    transition: color var(--duration-fast) var(--ease-out);
    margin-bottom: var(--space-6);
  }

  .ed-gc:hover .ed-gc__title {
    color: var(--accent);
  }
</style>
