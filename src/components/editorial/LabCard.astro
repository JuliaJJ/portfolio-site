---
// src/components/editorial/LabCard.astro
// Editorial theme lab card: horizontal layout, italic title, tag byline.

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"lab">;
}

const { entry } = Astro.props;
const { data, slug } = entry;

const href = data.link ?? `/lab/${slug}`;
const isExternal = !!data.link;
---

<a
  href={href}
  class="ed-lab"
  aria-label={`${data.title} — ${data.summary}`}
  {...isExternal ? { target: "_blank", rel: "noopener noreferrer" } : {}}
>
  <div class="ed-lab__byline">
    <span class="ed-lab__type">{data.type}</span>
    <span class="ed-lab__year">{data.year}</span>
    {data.tags.slice(0, 3).map((tag) => (
      <span class="ed-lab__tag">{tag}</span>
    ))}
  </div>

  <h2 class="ed-lab__title">{data.title}</h2>

  <div class="ed-lab__rule" aria-hidden="true"></div>

  <div class="ed-lab__body">
    <p class="ed-lab__summary">{data.summary}</p>
    <span class="ed-lab__cta" aria-hidden="true">
      {isExternal ? (data.link_label ?? "View project") + " ↗" : "View project →"}
    </span>
  </div>
</a>

<style>
  .ed-lab {
    display: block;
    padding: var(--space-8) 0;
    border-top: 1px solid var(--rule-2);
    text-decoration: none;
    color: inherit;
    transition: none;
  }

  .ed-lab__byline {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-bottom: var(--space-4);
  }

  .ed-lab__type {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    padding: 2px 8px;
    border: 1px solid var(--rule-2);
    color: var(--text-3);
  }

  .ed-lab__year {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-3);
  }

  .ed-lab__tag {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: var(--text-4);
    font-style: italic;
  }

  .ed-lab__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--text-1);
    margin-bottom: var(--space-5);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .ed-lab:hover .ed-lab__title { color: var(--accent); }

  .ed-lab__rule {
    height: 1px;
    background: var(--rule);
    margin-bottom: var(--space-4);
  }

  .ed-lab__body {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .ed-lab__summary {
    font-size: var(--text-base);
    color: var(--text-2);
    line-height: var(--leading-relaxed);
    max-width: 56ch;
  }

  .ed-lab__cta {
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    color: var(--text-3);
    white-space: nowrap;
    flex-shrink: 0;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .ed-lab:hover .ed-lab__cta { color: var(--accent); }

  @media (max-width: 640px) {
    .ed-lab__body {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }
</style>
