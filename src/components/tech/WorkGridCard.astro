---
// src/components/tech/WorkGridCard.astro
// Tech theme: compact two-column grid card for the work index.

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
  index: number;
}

const { entry, index } = Astro.props;
const { data, slug } = entry;
const visibleSkills = data.skills.slice(0, 3);
const extraSkills = data.skills.length - visibleSkills.length;
---

<a href={`/work/${slug}`} class="tc-gc" aria-label={`${data.title} — ${data.summary}`}>

  <div class="tc-gc__img-wrap">
    {data.cover_image ? (
      <img
        src={data.cover_image}
        alt={data.cover_alt ?? data.title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="img-placeholder">
        <span class="img-placeholder__label">Cover image</span>
      </div>
    )}
  </div>

  <div class="tc-gc__body">
    <div class="tc-gc__meta">
      {visibleSkills.map((s) => (
        <span class="tag tag--neutral">{s}</span>
      ))}
      {extraSkills > 0 && (
        <span class="tag tag--neutral">+{extraSkills}</span>
      )}
    </div>
    <p class="tc-gc__title">{data.title}</p>
  </div>

</a>

<style>
  .tc-gc {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .tc-gc__img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-out);
    margin-bottom: var(--space-4);
  }

  .tc-gc:hover .tc-gc__img-wrap {
    transform: translateY(-4px);
  }

  .tc-gc__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.25) brightness(0.85);
    transition:
      filter    400ms var(--ease-out),
      transform 500ms var(--ease-out);
  }

  .tc-gc:hover .tc-gc__img-wrap img {
    filter: saturate(1) brightness(1);
    transform: scale(1.02);
  }

  .tc-gc__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .tc-gc__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .tc-gc__title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.75rem);
    font-weight: var(--weight-black);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text-1);
    transition: color var(--duration-slow) var(--ease-out);
  }

  .tc-gc:hover .tc-gc__title {
    color: var(--accent);
  }

</style>
