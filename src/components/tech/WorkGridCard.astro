---
// src/components/tech/WorkGridCard.astro
// Tech theme: compact two-column grid card for the work index.

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
  index: number;
}

const { entry, index } = Astro.props;
const { data, slug } = entry;
const leadOutcome = data.outcomes?.[0] ?? null;
---

<a href={`/work/${slug}`} class="tc-gc" aria-label={`${data.title} — ${data.summary}`}>

  <div class="tc-gc__img-wrap">
    {data.cover_image ? (
      <img
        src={data.cover_image}
        alt={data.cover_alt ?? data.title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="img-placeholder">
        <span class="img-placeholder__label">Cover image</span>
      </div>
    )}
    {data.visibility === "partial" && (
      <span class="badge badge--partial tc-gc__badge">Process shown</span>
    )}
    {data.visibility === "request" && (
      <span class="badge badge--request tc-gc__badge">NDA</span>
    )}
  </div>

  <div class="tc-gc__body">
    <div class="tc-gc__meta">
      <span class={`tag tag--${data.domain}`}>{data.domain}</span>
    </div>
    <p class="tc-gc__title">{data.title}</p>
    {leadOutcome && (
      <div class="tc-gc__outcome">
        <span class="tc-gc__val">{leadOutcome.value}</span>
        <span class="tc-gc__metric">{leadOutcome.metric}</span>
      </div>
    )}
  </div>

</a>

<style>
  .tc-gc {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .tc-gc__img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-out);
    margin-bottom: var(--space-4);
  }

  .tc-gc:hover .tc-gc__img-wrap {
    transform: translateY(-4px);
  }

  .tc-gc__img-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.25) brightness(0.85);
    transition:
      filter    400ms var(--ease-out),
      transform 500ms var(--ease-out);
  }

  .tc-gc:hover .tc-gc__img-wrap img {
    filter: saturate(1) brightness(1);
    transform: scale(1.02);
  }

  .tc-gc__badge {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
  }

  .tc-gc__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .tc-gc__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .tc-gc__title {
    font-family: var(--font-display);
    font-size: clamp(0.95rem, 1.5vw, 1.2rem);
    font-weight: var(--weight-black);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text-1);
    transition: color var(--duration-slow) var(--ease-out);
  }

  .tc-gc:hover .tc-gc__title {
    color: var(--accent);
  }

  .tc-gc__outcome {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-top: var(--space-2);
  }

  .tc-gc__val {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: var(--weight-black);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    color: var(--text-3);
    transition: color var(--duration-slow) var(--ease-out);
  }

  .tc-gc:hover .tc-gc__val {
    color: var(--accent);
  }

  .tc-gc__metric {
    font-size: var(--text-xs);
    color: var(--text-3);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }
</style>
