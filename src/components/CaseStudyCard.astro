---
// src/components/CaseStudyCard.astro

import type { CollectionEntry } from "astro:content";

interface Props {
  entry: CollectionEntry<"work">;
}

const { entry } = Astro.props;
const { data, slug } = entry;

const visibleSkills = data.skills.slice(0, 3);
const extraSkills = data.skills.length - visibleSkills.length;
---

<a href={`/work/${slug}`} class="cs-card" aria-label={`${data.title} — ${data.summary}`}>

  <div class="cs-card__img-wrap">
    {data.cover_image ? (
      <img
        class="cs-card__img"
        src={data.cover_image}
        alt={data.cover_alt ?? data.title}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <div class="cs-card__placeholder" aria-hidden="true">
        <span class="cs-card__placeholder-label">{data.title}</span>
      </div>
    )}

  </div>

  <div class="cs-card__body">
    <div class="cs-card__meta">
      {visibleSkills.map((s) => (
        <span class="tag tag--neutral">{s}</span>
      ))}
      {extraSkills > 0 && (
        <span class="tag tag--neutral">+{extraSkills}</span>
      )}
    </div>
    <p class="cs-card__title">{data.title}</p>
    <p class="cs-card__summary">{data.summary}</p>
  </div>

</a>

<style>
  .cs-card {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  /* ── Image ── */

  .cs-card__img-wrap {
    position: relative;
    aspect-ratio: 2 / 1;
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .cs-card:hover .cs-card__img-wrap {
    transform: translateY(-4px);
  }

  .cs-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Muted at rest — blooms to full colour on hover */
    filter: saturate(0.25) brightness(0.85);
    transition:
      filter     400ms var(--ease-out),
      transform  500ms var(--ease-out);
  }

  .cs-card:hover .cs-card__img {
    filter: saturate(1) brightness(1);
    transform: scale(1.02);
  }

  /* Placeholder when no cover image is set */
  .cs-card__placeholder {
    width: 100%;
    height: 100%;
    background-color: var(--bg-3);
    background-image:
      linear-gradient(var(--rule) 1px, transparent 1px),
      linear-gradient(90deg, var(--rule) 1px, transparent 1px);
    background-size: 40px 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.5;
    transition: opacity 400ms var(--ease-out);
  }

  .cs-card:hover .cs-card__placeholder {
    opacity: 0.8;
  }

  .cs-card__placeholder-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-4);
  }

  /* ── Body ── */

  .cs-card__body {
    padding: var(--space-4) var(--space-1) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cs-card__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .cs-card__title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.2vw, 1.75rem);
    font-weight: var(--weight-black);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-tight);
    color: var(--text-1);
    transition: color var(--duration-slow) var(--ease-out);
  }

  .cs-card:hover .cs-card__title {
    color: var(--accent);
  }

  .cs-card__summary {
    font-size: var(--text-sm);
    color: var(--text-2);
    line-height: var(--leading-relaxed);
  }
</style>
