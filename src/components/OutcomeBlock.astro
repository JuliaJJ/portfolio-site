---
// src/components/OutcomeBlock.astro
// Renders a row of outcome cards from the frontmatter outcomes array.
// Front-loaded on case study pages — hiring managers scan for this first.

interface Outcome {
  metric: string;
  value: string;
  note?: string;
}

interface Props {
  outcomes: Outcome[];
  note?: string;
}

const { outcomes, note } = Astro.props;
---

<div class="outcome-block" aria-label="Project outcomes">
  <div class="outcome-block__grid">
    {outcomes.map((o) => (
      <div class="outcome-block__item">
        <div class="outcome-block__metric">{o.metric}</div>
        <div class="outcome-block__value">{o.value}</div>
        {o.note && (
          <div class="outcome-block__note">{o.note}</div>
        )}
      </div>
    ))}
  </div>
  {note && (
    <p class="outcome-block__footer-note">{note}</p>
  )}
</div>

<style>
  .outcome-block {
    margin: 2rem 0;
  }

  .outcome-block__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--space-3);
  }

  .outcome-block__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    background: var(--accent-dim);
    border-top: 2px solid var(--accent);
    border-radius: var(--radius-sm);
  }

  .outcome-block__metric {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-3);
  }

  .outcome-block__value {
    font-size: var(--text-md);
    font-weight: var(--weight-medium);
    color: var(--text-1);
    line-height: var(--leading-snug);
  }

  .outcome-block__note {
    font-size: var(--text-xs);
    color: var(--text-3);
    line-height: var(--leading-relaxed);
    margin-top: var(--space-1);
  }

  .outcome-block__footer-note {
    font-size: var(--text-xs);
    color: var(--text-3);
    margin-top: var(--space-4);
    padding-top: var(--space-4);
    border-top: var(--border);
    line-height: var(--leading-relaxed);
  }
</style>
