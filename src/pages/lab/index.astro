---
// src/pages/lab/index.astro

import { getCollection } from "astro:content";
import { createReader } from "@keystatic/core/reader";
import BaseLayout from "@layouts/BaseLayout.astro";
import DefaultLayout from "@layouts/DefaultLayout.astro";
import PixelLayout from "@layouts/PixelLayout.astro";
import EditorialLayout from "@layouts/EditorialLayout.astro";
import LabCard from "@components/LabCard.astro";
import PixelLabCard from "@components/pixel/LabCard.astro";
import EditorialLabCard from "@components/editorial/LabCard.astro";
import LabFilter from "@components/LabFilter.tsx";
import StudioLayout from "@layouts/StudioLayout.astro";
import StudioLabGridCard from "@components/studio/LabGridCard.astro";
import keystaticConfig from "../../../keystatic.config";

const reader = createReader(process.cwd(), keystaticConfig);
const labLanding = await reader.singletons.labLanding.read();

const allLab = await getCollection("lab", ({ data }) => !data.draft);
const sorted = allLab.sort((a, b) => {
  if (a.data.order !== undefined && b.data.order !== undefined) return a.data.order - b.data.order;
  return 0;
});

const types = [...new Set(sorted.map((e) => e.data.type))];
const tags  = [...new Set(sorted.flatMap((e) => e.data.tags))].filter(Boolean);
---

<BaseLayout
  title="Lab"
  description="Personal projects, design explorations, tools, and experiments — work done for curiosity, craft, and the fun of it."
>

  <!-- ═══════════════════════════════════════════════════════
       DEFAULT SHELL
       ═══════════════════════════════════════════════════════ -->
  <DefaultLayout>
    <div class="lab-default">

      <header class="lab-default__header">
        <h1>Lab</h1>
        <p class="lab-default__intro">{labLanding?.intro}</p>
      </header>

      {sorted.length === 0 ? (
        <div class="lab-empty">
          <p class="eyebrow">Coming soon</p>
          <p class="lab-empty__text">Nothing here yet — projects in progress. Check back soon.</p>
        </div>
      ) : (
        <>
          <LabFilter client:load types={types} tags={tags} />

          <ul class="lab-default__grid" role="list">
            {sorted.map((entry) => (
              <li
                data-lab-type={entry.data.type}
                data-lab-tags={entry.data.tags.join(",")}
              >
                <LabCard entry={entry} />
              </li>
            ))}
          </ul>
        </>
      )}

    </div>
  </DefaultLayout>


  <!-- ═══════════════════════════════════════════════════════
       PIXEL SHELL
       ═══════════════════════════════════════════════════════ -->
  <PixelLayout>
    <div class="lab-pixel">

      <div class="lab-pixel__header">
        <p class="lab-pixel__title">EXPERIMENTS</p>
        <p class="lab-pixel__sub">SIDE QUESTS &amp; BONUS CONTENT</p>
        <div class="lab-pixel__divider">════════════════════════════════</div>
      </div>

      {sorted.length === 0 ? (
        <div class="lab-pixel__empty">
          <p class="lab-pixel__empty-msg">[ NO DATA FOUND ]</p>
          <p class="lab-pixel__empty-sub">CONTENT LOADING... CHECK BACK SOON</p>
        </div>
      ) : (
        <div class="lab-pixel__list">
          {sorted.map((entry) => (
            <PixelLabCard entry={entry} />
          ))}
        </div>
      )}

    </div>
  </PixelLayout>


  <!-- ═══════════════════════════════════════════════════════
       EDITORIAL SHELL
       ═══════════════════════════════════════════════════════ -->
  <EditorialLayout>
    <div class="lab-editorial">

      <header class="lab-editorial__header">
        <h1 class="lab-editorial__title">Lab</h1>
        <p class="lab-editorial__intro">{labLanding?.intro}</p>
      </header>

      {sorted.length === 0 ? (
        <div class="lab-editorial__empty">
          <p class="lab-editorial__coming-soon">Coming soon.</p>
          <p>Projects in progress — check back soon.</p>
        </div>
      ) : (
        <ul class="lab-editorial__grid" role="list">
          {sorted.map((entry) => (
            <li>
              <EditorialLabCard entry={entry} />
            </li>
          ))}
        </ul>
      )}

    </div>
  </EditorialLayout>


  <!-- ═══════════════════════════════════════════════════════
       STUDIO SHELL
       ═══════════════════════════════════════════════════════ -->
  <StudioLayout>
    <div class="st-lab">

      <header class="st-lab__header">
        <h1 class="st-lab__title">Lab</h1>
        <p class="st-lab__intro">{labLanding?.intro}</p>
      </header>

      {sorted.length === 0 ? (
        <p class="st-lab__empty">Nothing here yet — projects in progress.</p>
      ) : (
        <ul class="st-lab__grid" role="list">
          {sorted.map((entry, i) => (
            <li style={`--st-delay: ${i * 60}ms`}>
              <StudioLabGridCard entry={entry} index={i + 1} />
            </li>
          ))}
        </ul>
      )}

    </div>
  </StudioLayout>

</BaseLayout>


<style>
  /* ── Default shell ───────────────────────────────────────── */

  .lab-default__header {
    padding-top: var(--space-12);
    padding-bottom: var(--space-10);
    max-width: 640px;
  }

  .lab-default__intro {
    font-size: var(--text-md);
    color: var(--text-2);
    line-height: var(--leading-relaxed);
    margin-top: var(--space-5);
  }

  .lab-default__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-4);
  }

  .lab-empty { padding: var(--space-16) 0; }

  .lab-empty__text {
    font-size: var(--text-base);
    color: var(--text-3);
    margin-top: var(--space-3);
  }

  @media (max-width: 640px) {
    .lab-default__grid { grid-template-columns: 1fr; }
  }

  /* ── Pixel shell ─────────────────────────────────────────── */

  .lab-pixel {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-6);
  }

  .lab-pixel__title {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .lab-pixel__sub {
    font-family: var(--font-display);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    color: var(--text-3);
  }

  .lab-pixel__divider {
    font-family: var(--font-display);
    font-size: 8px;
    color: var(--rule-2);
    overflow: hidden;
    white-space: nowrap;
  }

  .lab-pixel__empty {
    border: 2px solid var(--rule);
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .lab-pixel__empty-msg {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.1em;
    color: var(--text-3);
  }

  .lab-pixel__empty-sub {
    font-family: var(--font-display);
    font-size: 0.4rem;
    letter-spacing: 0.1em;
    color: var(--text-4);
    animation: pixel-blink 2s steps(1) infinite;
  }

  .lab-pixel__list {
    border: 2px solid var(--rule);
  }

  /* ── Editorial shell ─────────────────────────────────────── */

  .lab-editorial__header {
    padding-top: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 3px solid var(--text-1);
    margin-bottom: var(--space-8);
  }

  .lab-editorial__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3rem, 7vw, 5.5rem);
    letter-spacing: -0.04em;
    line-height: 0.92;
    margin-bottom: var(--space-6);
    color: var(--text-1);
  }

  .lab-editorial__intro {
    font-size: var(--text-lg);
    color: var(--text-2);
    line-height: var(--leading-relaxed);
    max-width: 52ch;
  }

  .lab-editorial__empty {
    padding: var(--space-16) 0;
    border-top: 1px solid var(--rule);
  }

  .lab-editorial__coming-soon {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--text-4);
    letter-spacing: -0.03em;
    margin-bottom: var(--space-4);
  }

  .lab-editorial__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    padding-bottom: var(--space-16);
    list-style: none;
  }

  @media (max-width: 640px) {
    .lab-editorial__grid { grid-template-columns: 1fr; }
  }

  /* ── Studio shell ────────────────────────────────────────── */

  .st-lab {
    padding-inline: var(--gutter);
  }

  .st-lab__header {
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-2);
  }

  .st-lab__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 6rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    color: var(--text-1);
    margin-bottom: var(--space-6);
  }

  .st-lab__intro {
    font-size: var(--text-md);
    color: var(--text-2);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
  }

  .st-lab__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12) var(--space-10);
    padding-top: var(--space-10);
    list-style: none;
  }

  @media (max-width: 640px) {
    .st-lab__grid { grid-template-columns: 1fr; }
  }

  .st-lab__empty {
    padding: var(--space-16) 0;
    color: var(--text-3);
    font-size: var(--text-sm);
  }
</style>
