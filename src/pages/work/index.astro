---
// src/pages/work/index.astro

import { getCollection } from "astro:content";
import { createReader } from "@keystatic/core/reader";
import BaseLayout from "@layouts/BaseLayout.astro";
import DefaultLayout from "@layouts/DefaultLayout.astro";
import PixelLayout from "@layouts/PixelLayout.astro";
import EditorialLayout from "@layouts/EditorialLayout.astro";
import MissionCard from "@components/pixel/MissionCard.astro";
import TechWorkGridCard from "@components/tech/WorkGridCard.astro";
import EditorialWorkGridCard from "@components/editorial/WorkGridCard.astro";
import DomainFilter from "@components/DomainFilter.tsx";
import StudioLayout from "@layouts/StudioLayout.astro";
import StudioWorkGridCard from "@components/studio/WorkGridCard.astro";
import StudioAdditionalWorkCard from "@components/studio/AdditionalWorkCard.astro";
import TechAdditionalWorkCard from "@components/tech/AdditionalWorkCard.astro";
import EditorialAdditionalWorkCard from "@components/editorial/AdditionalWorkCard.astro";
import PixelAdditionalWorkCard from "@components/pixel/AdditionalWorkCard.astro";
import keystaticConfig from "../../../keystatic.config";

const reader = createReader(process.cwd(), keystaticConfig);
const workLanding = await reader.singletons.workLanding.read();

const allWork = await getCollection("work");
const sorted = allWork.sort((a, b) => {
  if (a.data.featured && !b.data.featured) return -1;
  if (!a.data.featured && b.data.featured) return 1;
  if (a.data.order !== undefined && b.data.order !== undefined) {
    return a.data.order - b.data.order;
  }
  return 0;
});

const allAdditional = await getCollection("additionalWork");
const sortedAdditional = allAdditional
  .filter((e) => !e.data.draft)
  .sort((a, b) => {
    if (a.data.order !== undefined && b.data.order !== undefined) {
      return a.data.order - b.data.order;
    }
    return 0;
  });

const types = ["all", ...new Set(sorted.flatMap((e) => e.data.problem_types))];
---

<BaseLayout
  title="Work"
  description="UX design case studies across healthcare, ecommerce, enterprise, and web — 20 years of designing for complexity."
>

  <!-- ═══════════════════════════════════════════════════════
       DEFAULT SHELL
       ═══════════════════════════════════════════════════════ -->
  <DefaultLayout>
    <div class="work-default">

      <header class="work-default__header">
        <h1>Work</h1>
        <p class="work-default__intro">{workLanding?.intro}</p>
      </header>

      <!-- DomainFilter only operates on default shell cards -->
      <DomainFilter client:load types={types} />

      <ul class="work-default__grid" role="list">
        {sorted.map((entry, i) => (
          <li
            data-card-types={entry.data.problem_types.join(",")}
          >
            <TechWorkGridCard entry={entry} index={i + 1} />
          </li>
        ))}
      </ul>

      {sortedAdditional.length > 0 && (
        <section class="work-default__additional">
          <h2 class="work-default__additional-heading">Additional Work</h2>
          <ul class="work-default__additional-grid" role="list">
            {sortedAdditional.map((entry) => (
              <li><TechAdditionalWorkCard entry={entry} /></li>
            ))}
          </ul>
        </section>
      )}

    </div>
  </DefaultLayout>


  <!-- ═══════════════════════════════════════════════════════
       PIXEL SHELL
       ═══════════════════════════════════════════════════════ -->
  <PixelLayout>
    <div class="work-pixel">

      <div class="work-pixel__header">
        <p class="work-pixel__title">MISSION SELECT</p>
        <p class="work-pixel__sub">CHOOSE YOUR MISSION · {sorted.length} AVAILABLE</p>
        <div class="work-pixel__divider">════════════════════════════════</div>
      </div>

      <div class="work-pixel__list">
        {sorted.map((entry, i) => (
          <MissionCard entry={entry} index={i + 1} />
        ))}
      </div>

      {sortedAdditional.length > 0 && (
        <div class="work-pixel__additional">
          <p class="work-pixel__additional-head">ADDITIONAL WORK · {sortedAdditional.length} ENTRIES</p>
          <div class="work-pixel__additional-list">
            {sortedAdditional.map((entry) => (
              <PixelAdditionalWorkCard entry={entry} />
            ))}
          </div>
        </div>
      )}

    </div>
  </PixelLayout>


  <!-- ═══════════════════════════════════════════════════════
       EDITORIAL SHELL
       ═══════════════════════════════════════════════════════ -->
  <EditorialLayout>
    <div class="work-editorial">

      <header class="work-editorial__header">
        <h1 class="work-editorial__title">Work</h1>
        <p class="work-editorial__intro">{workLanding?.intro}</p>
      </header>

      <ul class="work-editorial__grid" role="list">
        {sorted.map((entry, i) => (
          <li>
            <EditorialWorkGridCard entry={entry} index={i + 1} />
          </li>
        ))}
      </ul>

      {sortedAdditional.length > 0 && (
        <section class="work-editorial__additional">
          <h2 class="work-editorial__additional-heading">Additional Work</h2>
          <ul class="work-editorial__additional-grid" role="list">
            {sortedAdditional.map((entry) => (
              <li><EditorialAdditionalWorkCard entry={entry} /></li>
            ))}
          </ul>
        </section>
      )}

    </div>
  </EditorialLayout>


  <!-- ═══════════════════════════════════════════════════════
       STUDIO SHELL
       ═══════════════════════════════════════════════════════ -->
  <StudioLayout>
    <div class="st-work">

      <header class="st-work__header">
        <h1 class="st-work__title">Work</h1>
        <p class="st-work__intro">{workLanding?.intro}</p>
      </header>

      {sorted.length === 0 ? (
        <p class="st-work__empty">No case studies yet.</p>
      ) : (
        <ul class="st-work__grid" role="list">
          {sorted.map((entry, i) => (
            <li style={`--st-delay: ${i * 60}ms`}>
              <StudioWorkGridCard entry={entry} index={i + 1} />
            </li>
          ))}
        </ul>
      )}

      {sortedAdditional.length > 0 && (
        <section class="st-work__additional">
          <h2 class="st-work__additional-heading">Additional Work</h2>
          <ul class="st-work__additional-grid" role="list">
            {sortedAdditional.map((entry) => (
              <li><StudioAdditionalWorkCard entry={entry} /></li>
            ))}
          </ul>
        </section>
      )}

    </div>
  </StudioLayout>

</BaseLayout>


<style>
  /* ── Default shell ───────────────────────────────────────── */

  .work-default__header {
    padding-top: var(--space-12);
    padding-bottom: var(--space-10);
    max-width: 640px;
  }

  .work-default__intro {
    font-size: var(--text-md);
    color: var(--text-2);
    line-height: var(--leading-relaxed);
    margin-top: var(--space-5);
  }

  .work-default__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-16) var(--space-8);
    list-style: none;
  }

  @media (max-width: 640px) {
    .work-default__grid { grid-template-columns: 1fr; }
  }

  /* ── Pixel shell ─────────────────────────────────────────── */

  .work-pixel {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-top: var(--space-6);
  }

  .work-pixel__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .work-pixel__title {
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .work-pixel__sub {
    font-family: var(--font-display);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    color: var(--text-3);
  }

  .work-pixel__divider {
    font-family: var(--font-display);
    font-size: 8px;
    color: var(--rule-2);
    letter-spacing: -0.02em;
    overflow: hidden;
    white-space: nowrap;
  }

  .work-pixel__list {
    border: 2px solid var(--rule);
  }

  /* ── Editorial shell ─────────────────────────────────────── */

  .work-editorial__header {
    padding-top: var(--space-12);
    padding-bottom: var(--space-10);
    border-bottom: 3px solid var(--text-1);
    margin-bottom: var(--space-4);
  }

  .work-editorial__title {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(3rem, 7vw, 5.5rem);
    letter-spacing: -0.04em;
    line-height: 0.92;
    margin-bottom: var(--space-6);
    color: var(--text-1);
  }

  .work-editorial__intro {
    font-size: var(--text-md);
    color: var(--text-2);
    line-height: var(--leading-relaxed);
    max-width: 62ch;
  }

  .work-editorial__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10) var(--space-10);
    padding-bottom: var(--space-16);
    list-style: none;
  }

  @media (max-width: 640px) {
    .work-editorial__grid { grid-template-columns: 1fr; }
  }

  /* ── Studio shell ────────────────────────────────────────── */

  .st-work {
    padding-inline: var(--gutter);
  }

  .st-work__header {
    padding-top: var(--space-16);
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--rule);
    margin-bottom: var(--space-2);
  }

  .st-work__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 7vw, 6rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.03em;
    line-height: var(--leading-tight);
    color: var(--text-1);
    margin-bottom: var(--space-6);
  }

  .st-work__intro {
    font-size: var(--text-md);
    color: var(--text-2);
    line-height: var(--leading-relaxed);
    max-width: 60ch;
  }

  .st-work__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12) var(--space-10);
    padding-top: var(--space-10);
    list-style: none;
  }

  @media (max-width: 640px) {
    .st-work__grid { grid-template-columns: 1fr; }
  }

  .st-work__empty {
    padding: var(--space-16) 0;
    color: var(--text-3);
    font-size: var(--text-sm);
  }

  /* ── Additional Work sections ─────────────────────────────── */

  /* Default / Tech */
  .work-default__additional {
    padding-top: var(--space-16);
    border-top: var(--border);
    margin-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .work-default__additional-heading {
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--text-3);
    margin-bottom: var(--space-8);
  }

  .work-default__additional-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10) var(--space-8);
    list-style: none;
  }

  @media (max-width: 640px) {
    .work-default__additional-grid { grid-template-columns: 1fr; }
  }

  /* Pixel */
  .work-pixel__additional {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border-top: 2px solid var(--rule);
    padding-top: var(--space-6);
  }

  .work-pixel__additional-head {
    font-family: var(--font-display);
    font-size: 0.5rem;
    letter-spacing: 0.12em;
    color: var(--text-4);
  }

  .work-pixel__additional-list {
    border: 2px solid var(--rule);
  }

  /* Editorial */
  .work-editorial__additional {
    padding-top: var(--space-16);
    border-top: 3px solid var(--text-1);
    margin-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .work-editorial__additional-heading {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 700;
    font-size: clamp(1.5rem, 3vw, 2.5rem);
    letter-spacing: -0.03em;
    color: var(--text-1);
    margin-bottom: var(--space-10);
  }

  .work-editorial__additional-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10) var(--space-10);
    list-style: none;
  }

  @media (max-width: 640px) {
    .work-editorial__additional-grid { grid-template-columns: 1fr; }
  }

  /* Studio */
  .st-work__additional {
    padding-top: var(--space-16);
    border-top: 1px solid var(--rule);
    margin-top: var(--space-16);
    padding-bottom: var(--space-16);
  }

  .st-work__additional-heading {
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.5rem);
    font-weight: var(--weight-light);
    letter-spacing: -0.01em;
    color: var(--text-3);
    margin-bottom: var(--space-10);
  }

  .st-work__additional-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10) var(--space-8);
    list-style: none;
  }

  @media (max-width: 640px) {
    .st-work__additional-grid { grid-template-columns: 1fr; }
  }
</style>
